[gd_scene load_steps=15 format=3]

[ext_resource type="PackedScene" path="res://scenes/session/GameSession.tscn" id="1_session"]
[ext_resource type="PackedScene" path="res://scenes/player/Player.tscn" id="2_player"]
[ext_resource type="Script" path="res://scripts/test/temporal_test_gate.gd" id="3_gate"]
[ext_resource type="Script" path="res://scripts/interaction/interactable.gd" id="4_interactable"]
[ext_resource type="Script" path="res://scripts/test/temporal_test_shutter.gd" id="5_shutter"]
[ext_resource type="Script" path="res://scripts/test/temporal_test_gear.gd" id="6_gear"]
[ext_resource type="Script" path="res://scripts/interaction/trigger_zone.gd" id="7_trigger"]
[ext_resource type="Script" path="res://scripts/temporal/temporal_component.gd" id="8_temporal"]

[sub_resource type="GDScript" id="GDScript_room"]
script/source = "extends Node2D

@onready var plate: TriggerZone = $PressurePlate
@onready var echo_gate: TemporalTestGate = $EchoGate

func _ready() -> void:
	if plate != null and echo_gate != null:
		plate.occupancy_changed.connect(_on_plate_occupancy_changed)

func _on_plate_occupancy_changed(is_occupied: bool) -> void:
	if echo_gate != null:
		echo_gate.apply_state({
			\"arm_state\": &\"open\" if is_occupied else &\"collapsed\",
			\"passage_blocked\": not is_occupied
		})
"

[sub_resource type="CircleShape2D" id="CircleShape2D_gate"]
radius = 18.0

[sub_resource type="CircleShape2D" id="CircleShape2D_pillar"]
radius = 16.0

[sub_resource type="CircleShape2D" id="CircleShape2D_anchor"]
radius = 16.0

[sub_resource type="CircleShape2D" id="CircleShape2D_shutter"]
radius = 20.0

[sub_resource type="CircleShape2D" id="CircleShape2D_gear"]
radius = 16.0

[sub_resource type="RectangleShape2D" id="RectangleShape2D_plate"]
size = Vector2(32, 24)

[node name="TemporalTestRoom" type="Node2D"]
y_sort_enabled = true
script = SubResource("GDScript_room")

[node name="GameSession" parent="." instance=ExtResource("1_session")]

[node name="Floor" type="Polygon2D" parent="."]
z_index = -1
color = Color(0.14, 0.16, 0.2, 1)
polygon = PackedVector2Array(320, 60, 560, 180, 320, 300, 80, 180)

[node name="GridLines" type="Polygon2D" parent="."]
