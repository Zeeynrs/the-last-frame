[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/session/game_session.gd" id="1_session"]
[ext_resource type="Script" path="res://scripts/session/sim_clock.gd" id="2_clock"]
[ext_resource type="Script" path="res://scripts/session/id_registry.gd" id="3_registry"]
[ext_resource type="Script" path="res://scripts/session/interaction_service.gd" id="4_interaction"]
[ext_resource type="Script" path="res://scripts/echo/echo_service.gd" id="5_echo"]
[ext_resource type="Script" path="res://scripts/puzzle/puzzle_service.gd" id="6_puzzle"]
[ext_resource type="Script" path="res://scripts/narrative/narrative_state.gd" id="7_narrative"]
[ext_resource type="Script" path="res://scripts/spatial/spatial_service.gd" id="8_spatial"]
[ext_resource type="Script" path="res://scripts/puzzle/hint_service.gd" id="9_hint"]

[node name="GameSession" type="Node" groups=["game_session"] node_paths=PackedStringArray("sim_clock", "id_registry", "interaction_service", "echo_service", "puzzle_service", "narrative_state", "spatial_service", "hint_service")]
script = ExtResource("1_session")
sim_clock = NodePath("SimClock")
id_registry = NodePath("IdRegistry")
interaction_service = NodePath("InteractionService")
echo_service = NodePath("EchoService")
puzzle_service = NodePath("PuzzleService")
narrative_state = NodePath("NarrativeState")
spatial_service = NodePath("SpatialService")
hint_service = NodePath("HintService")

[node name="SimClock" type="Node" parent="."]
script = ExtResource("2_clock")

[node name="IdRegistry" type="Node" parent="."]
script = ExtResource("3_registry")

[node name="InteractionService" type="Node" parent="." node_paths=PackedStringArray("id_registry", "sim_clock")]
script = ExtResource("4_interaction")
id_registry = NodePath("../IdRegistry")
sim_clock = NodePath("../SimClock")

[node name="EchoService" type="Node" parent="." node_paths=PackedStringArray("sim_clock", "interaction_service")]
script = ExtResource("5_echo")
sim_clock = NodePath("../SimClock")
interaction_service = NodePath("../InteractionService")

[node name="PuzzleService" type="Node" parent="." node_paths=PackedStringArray("sim_clock", "echo_service")]
script = ExtResource("6_puzzle")
sim_clock = NodePath("../SimClock")
echo_service = NodePath("../EchoService")

[node name="NarrativeState" type="Node" parent="."]
script = ExtResource("7_narrative")

[node name="SpatialService" type="Node" parent="."]
script = ExtResource("8_spatial")

[node name="HintService" type="Node" parent="." node_paths=PackedStringArray("sim_clock", "puzzle_service")]
script = ExtResource("9_hint")
sim_clock = NodePath("../SimClock")
puzzle_service = NodePath("../PuzzleService")

